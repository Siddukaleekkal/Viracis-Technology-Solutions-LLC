# Viracis Lead Routing & Notifications Environment Variables

# 1. Resend (Primary Email Delivery Engine)
# Obtain an API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# When your custom domain (viracis.com) is verified at https://resend.com/domains:
# RESEND_FROM_EMAIL="Viracis <notifications@viracis.com>"
# If using the default unverified testing domain:
RESEND_FROM_EMAIL="Viracis Lead Notifications <onboarding@resend.dev>"

# Destination email for demo requests
CONTACT_DESTINATION_EMAIL=siddu@viracis.com

# Fallback email if domain is unverified (Resend test mode delivers to account owner)
FALLBACK_DESTINATION_EMAIL=siddukaleekkal@gmail.com

# 2. Web3Forms (Optional Zero-DNS Direct-to-Email Fallback)
# Create a free key at https://web3forms.com for siddu@viracis.com
WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# 3. Supabase (Optional Database Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
